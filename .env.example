# Production. Copy to .env and fill every GitHub/Pangolin value you use.
# `docker compose up -d --build` reads .env and compose.yml by default.

# --- mediation server ---
AUTH_MODE=github-app
PUBLIC_URL=https://mediation.example.com
GITHUB_BOOTSTRAP_ADMIN=your-github-login

GITHUB_APP_ID=123456
GITHUB_APP_CLIENT_ID=Iv23_your_client_id
# compose.yml mounts the matching ./secrets/* host files at these paths.
GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/github-app.pem
GITHUB_APP_CLIENT_SECRET_FILE=/run/secrets/github-client-secret
GITHUB_WEBHOOK_SECRET_FILE=/run/secrets/github-webhook-secret

HOST=0.0.0.0
PORT=4100
DB_PATH=/data/mediation.db
SESSION_TTL_MS=120000

# --- Pangolin Newt tunnel (optional) ---
PANGOLIN_ENDPOINT=
NEWT_ID=
NEWT_SECRET=
